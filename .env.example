# Copy to .env (gitignored) and fill in real values to run the :app demo locally.
# Real environment variables (e.g. in CI) always take precedence over this file — see
# app/build.gradle.kts.

# usp-widget "alfred" dev server the demo mints orchestration sessions against.
# Run `npm run dev:alfred` from the usp-widget repo root, then point here:
#   - Emulator:        http://10.0.2.2:9001
#   - Physical device: http://<your-machine-LAN-IP>:9001
# Leave blank to fall back to the emulator default (http://10.0.2.2:9001).
ALFRED_BASE_URL=
