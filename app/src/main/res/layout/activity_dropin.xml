<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/sessionSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="Session:\n  id: abc123\n  amount: 100.00 EUR" />

        <LinearLayout
            android:id="@+id/dropinContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/payButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:visibility="gone"
            tools:text="Pay 100.00 EUR"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/payStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <!--
        Debug tool mirroring usp-widget's sites/demo "confirmation" page
        (sites/demo/src/routes/widgets/confirmation/+page.svelte): an editable session id +
        "Get Transactions" button that calls alfred's own GET /payment_session/:id (which alfred
        forwards to the real Payment API's GET /{entity}/sessions/{session}) — independent of
        whichever payment flow ran in this Activity. See docs/internal/testing-with-alfred.md.
        -->
        <LinearLayout
            android:id="@+id/alfredSessionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/alfredSessionIdLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/alfred_session_id_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alfredSessionIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getSessionViaAlfredButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/get_session_via_alfred" />

        </LinearLayout>

        <TextView
            android:id="@+id/alfredSessionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
