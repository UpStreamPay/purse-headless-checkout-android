<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/alfredBaseUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            tools:text="Alfred: http://10.0.2.2:9001" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/helper_alfred_base_url"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createSessionButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_create_session" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/widgetDataLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_widget_data"
            app:endIconMode="clear_text"
            app:helperText="@string/helper_widget_data"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/widgetDataInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/initCheckoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_init_checkout" />

        <!-- Secondary (co-payment) section — populated per secondary method on init; hidden until
             a session with secondary methods exists. -->
        <LinearLayout
            android:id="@+id/secondarySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_secondary"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/helper_giftcard"
                android:textSize="12sp" />

            <!-- One collapsible form per secondary method is added here at runtime. -->
            <LinearLayout
                android:id="@+id/secondaryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Google Pay is an "xpay" — usp-widget's own googlepay plugin appends this button as
             soon as isReadyToPay resolves (onDataUpdate) and its own onButtonClicked dispatches
             requestValidate itself once the sheet returns, with no separate submit step; the
             pre-headless `master` demo mirrors this with a dedicated renderXpay group, kept apart
             from the "other primaries" radio list below. So this button is always visible once
             ready — never gated behind selecting a row first. -->
        <com.google.android.gms.wallet.button.PayButton
            android:id="@+id/googlePayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- The remaining primaries this demo drives (Klarna, card) — one collapsible row per
             method, mirroring the secondary (gift card) list above: tap a row's header to select
             it, which commits it via setPrimary AND reveals its actual payment control — only the
             selected row's SecureFields/Klarna setup is ever mounted. Mutually exclusive (unlike
             the gift-card list, since only one primary applies at a time) — see
             MainActivity.selectPrimary. Google Pay never appears here — see the button above. -->
        <LinearLayout
            android:id="@+id/primarySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_primary"
                android:textAppearance="?attr/textAppearanceSubtitle1" />

            <LinearLayout
                android:id="@+id/primaryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- One global submit action for whichever primary is selected (Klarna, card) plus
             secondaries — mirrors usp-widget's own single PayButton / the pre-headless `master`
             demo's shared payButton: enabled once the split is fulfilled AND (no primary is
             needed, or the selected primary reports itself ready) — see
             MainActivity.updateSubmitButtonState. Google Pay is the one deliberate exception: its
             own branded button above is the trigger (Google's own tap-to-pay convention), never
             this one. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitPaymentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_submit_payment"
            android:enabled="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:text="@string/output_placeholder" />

        <!--
        Debug tool mirroring usp-widget's sites/demo "confirmation" page
        (sites/demo/src/routes/widgets/confirmation/+page.svelte): an editable session id +
        "Get Transactions" button that calls alfred's own GET /payment_session/:id (which alfred
        forwards to the real Payment API's GET /{entity}/sessions/{session}) — independent of
        whichever payment flow ran in this Activity. See docs/internal/testing-with-alfred.md.
        -->
        <LinearLayout
            android:id="@+id/alfredSessionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/alfredSessionIdLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/alfred_session_id_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/alfredSessionIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getSessionViaAlfredButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/get_session_via_alfred" />

        </LinearLayout>

        <TextView
            android:id="@+id/alfredSessionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <!--
        Debug tool calling alfred's own POST /payments/:paymentId/capture (added alongside this
        module — alfred previously only proxied session create/get), which forwards to the
        orchestration API's POST /v2/payments/{id}/captures using alfred's own server-side
        credentials — for a capture_mode: MANUAL payment, or any client whose own client-facing
        api_key isn't authorized to call that endpoint directly.
        -->
        <LinearLayout
            android:id="@+id/alfredCaptureRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/capturePaymentIdLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/capture_payment_id_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/capturePaymentIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/captureAmountLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="@string/capture_amount_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/captureAmountInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:inputType="numberDecimal"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/captureButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_capture" />

        </LinearLayout>

        <TextView
            android:id="@+id/captureResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
