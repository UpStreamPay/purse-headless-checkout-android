<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
          Declares Google Pay support for the integrating app — required by the Google Pay API so it
          (and the Play Store) know this app integrates it. Ships here so the integrator needs no
          manifest work of their own.
        -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />

        <!--
          The shared redirect return Activity — an in-app WebView that follows whatever a /validate
          asked for (GET, POST form, or injected HTML) and reports when the shopper comes back. Used
          by every plugin: a 3-D Secure hop after Google Pay / a card, an external bank or ID step
          after Klarna, and the whole payment step for the generic redirection template. Ships here
          so it merges into any integrating app with no manifest work. The deep-link scheme is the
          app's own applicationId plus ".redirect" so it can never collide with another partner's
          return path.
        -->
        <activity
            android:name="eu.purse.partnerui.redirect.RedirectionCheckoutActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.redirect" />
            </intent-filter>
        </activity>
    </application>

</manifest>
